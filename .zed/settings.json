{
  "prettier": {
    "allowed": true,
  },
  "languages": {
    "Rust": {
      "language_servers": ["tailwindcss-language-server", "rust-analyzer"],
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "rust": "html",
          "*.rs": "html",
        },
      },
    },
  },
}
